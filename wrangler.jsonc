{
  "name": "aparimeya-art",
  "compatibility_date": "2025-08-23",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "assets": {
    "directory": ".svelte-kit/cloudflare",
    "binding": "ASSETS"
  },
  "vars": {
    "NODE_ENV": "production"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    {
      "pattern": "aparimeya.art",
      "custom_domain": true,
      "zone_id": "05c6a19ca38d2a2cb5c22bf4cc9918e7"
    },
    {
      "pattern": "www.aparimeya.art",
      "custom_domain": true,
      "zone_id": "05c6a19ca38d2a2cb5c22bf4cc9918e7"
    }
  ]
}
